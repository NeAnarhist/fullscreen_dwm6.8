+void
+fullscreen(const Arg *arg) {
+Client *c = selmon->sel;
+        if (c) {
+                if (c->isfullscreen == 0)
+                        setfullscreen(c, 1);
+                else setfullscreen (c, 0);
+        } else return;
+}
+
+void
+maximize(const Arg *arg) {
+Client *c = selmon->sel;
+        if (c) {
+                if (selmon->lt[selmon->sellt] != &layouts[2]) {
+                /*      c->bw = 0; */
+                        setlayout(&((Arg) {.v = &layouts[2]})); /* Uncomment these two lines if you want the window borders to be hidden.*/
+                } else {
+                /*      c->bw = borderpx;*/
+                        setlayout(&((Arg) {.v = selmon->lt[!selmon->sellt]}));
+                }
+        } else return;
+}
